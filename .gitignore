# backend
/data/
*.db
*.db-wal
*.db-shm
config.json
scheduler_state.json
__pycache__/
*.pyc
*.pyo

# frontend
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo
web/next-env.d.ts
*.local

# development tools
.playwright-mcp/
.playwright-cli/
.idea/
.vscode/
*.swp
*.swo

# docs
/docs/

# os
.DS_Store
Thumbs.db

# claude code local state
.claude/

# Single-binary artifact with the frontend embedded (artex.exe on Windows)
/artex
/artex.exe
# Intermediates the one-click update leaves next to the executable (staged file / backup / failed version / upgrade marker)
/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/artex.exe.new
/artex.exe.new.sha256
/artex.exe.old
/artex.exe.failed
/server/webui/dist/
/dist/

# JWT signing key (generated at runtime, stored at the project root, never committed)
/jwt.key

# Local environment generated by the Docker deployment (contains passwords/keys, not committed)
.env

# Local compose overrides (e.g. pointing at a locally built image); the tracked
# template is docker-compose.override.yml.example
docker-compose.override.yml

# Event logs produced by scheduler runs/simulations (test artifacts, not committed)
*-events.csv

# bench benchmarking files (local artifacts, not committed)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2
# Static export of the web UI (build artifact, embedded into the Go binary)
/web/out/

# Containerized build caches (scripts/build-en.sh)
/.build-cache/

# local secrets (test accounts, API keys) — never commit
.secrets/

# worktrees (superpowers skill)
/.worktrees/
